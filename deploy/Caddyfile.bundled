# Used by the bundled "caddy" service in docker-compose.prod.yml.
{$FLOWFORGE_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	reverse_proxy app:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		# long workflow runs and MCP calls
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}
