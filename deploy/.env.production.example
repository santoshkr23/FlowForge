# ───────── FlowForge on your VPS ─────────
# deploy/install.sh fills in the secrets for you. Never commit this file.

# Your public address (no trailing slash). Must match the domain in your reverse proxy.
APP_URL=https://flowforge.example.com
FLOWFORGE_DOMAIN=flowforge.example.com
# Port on 127.0.0.1 your reverse proxy forwards to (pick a free one if 3100 is taken by another site)
FLOWFORGE_PORT=3100

# Database: leave DATABASE_URL empty to use the Postgres container in docker-compose.prod.yml.
# To keep using Neon instead, paste its connection string here.
POSTGRES_PASSWORD=
DATABASE_URL=

# openssl rand -hex 32
AUTH_SECRET=
# openssl rand -hex 32 — if you're moving from Render, paste the SAME key you used there,
# otherwise every saved connection (LinkedIn etc.) stops working. Never change it later.
ENCRYPTION_KEY=

# Your login email — gets /admin and can use the Claude connector on any plan
ADMIN_EMAILS=

# Uploaded videos (inside the container; the compose file keeps them in a volume)
MEDIA_DIR=/app/data/media
MAX_VIDEO_MB=1024

# ───────── Optional: same as on Render ─────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=openai
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=202608
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
