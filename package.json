{
  "name": "flowforge",
  "version": "0.1.0",
  "private": true,
  "description": "FlowForge — visual workflow automation SaaS with AI agents, credits billing (Stripe + Razorpay) and an MCP endpoint.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx worker/index.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "DATABASE_URL=pglite://memory ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "start:prod": "tsx scripts/migrate.ts && next start"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@xyflow/react": "^12.3.6",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "clsx": "^2.1.1",
    "cron-parser": "^4.9.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "nodemailer": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^17.5.0",
    "tsx": "^4.19.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "$postcss",
    "esbuild": "^0.25.12",
    "glob": "^10.5.0"
  }
}
